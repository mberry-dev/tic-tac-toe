<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp">

    <!-- Toggle between Player vs Player and Player vs AI -->
    <Button
        android:id="@+id/modeButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mode_pvp"
        android:layout_marginBottom="8dp" />

    <!-- Score tracker -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/xScoreText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="X: 0"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/holo_blue_dark"
            android:paddingEnd="24dp"/>

        <TextView
            android:id="@+id/oScoreText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="O: 0"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/holo_red_dark"/>

    </LinearLayout>

    <!-- Shows whose turn it is -->
    <TextView
        android:id="@+id/playerTurn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/player_turn"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Shows win or tie result; empty until game ends -->
    <TextView
        android:id="@+id/gameResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/winner_text"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:paddingTop="4dp" />

</LinearLayout>